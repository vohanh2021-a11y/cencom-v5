# === Telegram ===
# BotFather token (required). Keep secret.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# === opencode headless server ===
# Start it (same machine or LAN) with:  opencode serve --port 4096
OPENCEDE_SERVE_URL=http://127.0.0.1:4096
# Optional auth token for opencode serve (if configured)
OPENCEDE_SERVE_TOKEN=

# === Access control (fail-closed) ===
# Numeric Telegram USER IDs allowed to drive the bot (comma-separated). Empty = reject all.
ALLOWED_USER_IDS=123456789
# Optional: group/supergroup chat IDs allowed to trigger the bot
ALLOWED_CHAT_IDS=
# In groups, only respond when @mentioned or a /command is used
REQUIRE_MENTION=true

# === Model auto-switch pool (Hermes) ===
# "zen" = internal opencode free tier; "b.ai" = provider 2009.
# Leave MODEL_POOL empty to use the built-in default pool below.
# Format: provider/model,provider/model,...
# MODEL_POOL=opencode/hy3-free,2009/mimo-v2.5,2009/hy3
MODEL_POOL=
# Cooldown (ms) a model that hit a real error (429/5xx) is avoided before retrying.
# 30 min: khớp nhịp xoay vòng, tránh retry ngay 1 key đang bị limit.
MODEL_COOLDOWN_MS=1800000
# Max switch attempts per prompt before giving up
MODEL_MAX_ATTEMPTS=6
# Minimum time (ms) to KEEP one model before periodic rotation. 30 min.
MODEL_DWELL_MS=1800000
# If a model sends NO first chunk within this window (ms) it is treated as DEAD and switched.
# Set HIGH (5 min) so a merely SLOW free model is NOT falsely failed. Only truly dead >5min switches.
NO_RESPONSE_TIMEOUT_MS=300000

# === Misc ===
MAX_PROMPT_LEN=4000
LOG_LEVEL=INFO
HOME_CHANNEL=
OPENCEDE_AGENT=
BRIDGE_STATE_FILE=./state.json
# Optional webhook mode (cloud). If set, also set the secret.
# TELEGRAM_WEBHOOK_URL=https://your.host/telegram
# TELEGRAM_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
