# ---- Database (PostgreSQL / Supabase) ----
# Supabase: Project Settings -> Database -> Connection string (dùng pooler transaction nếu có)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cencom_os

# ---- Supabase (dùng khi triển khai realtime/storage) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ---- Bảo mật ----
# Secret dùng để ký/giải mã cookie session (sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=thay-bang-64-ky-tu-hex-random
# Bật cờ Secure cookie khi chạy HTTPS (production): 1
SECURE_COOKIE=0
# Bật chặn đăng nhập sai nhiều lần (production): 1
LOGIN_RATE_LIMIT=0

# ---- Seed (chỉ dùng CLI, KHÔNG dùng production) ----
# Buộc tất cả tài khoản phải đổi mật khẩu khi seed (production): 1
FORCE_PW_CHANGE=0
# Cho phép reset dữ liệu khi chạy seed lại (chỉ dùng local/dev): 1
ALLOW_RESET=0
