# MCP Server Service Account Configuration
# Copy this file to .env.mcp and fill in the values
# .env.mcp is gitignored (see .gitignore)

# Service account credentials (user must exist in users table)
MCP_USER=mcp-bot
MCP_PASS=change_me_secure_password
# Role override: if set and differs from DB role, auth will fail
# Suggested: giamdoc (read-only + activityFeed), or quantrivien for write access
MCP_ROLE=giamdoc

# Comma-separated list of WRITE tool names allowed for this service account
# Default empty = all write tools blocked (read-only mode)
# Example: MCP_WRITE_TOOLS=scCreate,keHoachSave,baogiaSave,hoSoSave
MCP_WRITE_TOOLS=

# Fallback: these are loaded from ../.env.local if not set above
# DATABASE_URL=postgresql://...
# SESSION_SECRET=...