# =============================================================================
# CencomOS Gara v5 — Environment Variables
# =============================================================================
# Copy file này thành .env.local và điền giá trị thực.
# KHÔNG commit .env.local vào git.

# --- Database (BẮT BUỘC) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cencom

# --- Session (BẮT BUỘC) — 32+ hex chars ---
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-strong-secret

# --- App ---
# PORT=3000          # Default: 3000
# HOSTNAME=0.0.0.0   # Default: 0.0.0.0
# NODE_ENV=development
# LOG_LEVEL=info

# --- MCP Server (optional) ---
# MCP_TRANSPORT=stdio       # stdio | http
# MCP_HTTP_PORT=3001        # HTTP transport port
# MCP_USER=admin            # Service account username
# MCP_PASS=                 # Service account password
# MCP_ROLE=giamdoc          # Default role for MCP calls
# MCP_WRITE_TOOLS=          # Comma-separated write tool names (empty = read-only)
# MCP_API_KEY=              # Bearer token for HTTP transport
