# =============================================================================
# .gitignore — CencomOS Gara 4.0 (Monorepo)
# =============================================================================

# Dependencies
node_modules/
**/node_modules/

# Build outputs
.next/
out/
build/
dist/
*.bin
standalone-build.bin

# Environment files (SECRETS - NEVER COMMIT)
.env
.env.local
.env.*.local
.env.onpremise.local
.env.production.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test artifacts
test-results/
playwright-report/
coverage/
*.lcov
.nyc_output/

# Logs
*.log

# DesktopLauncher (Tauri) - build outputs & generated files
DesktopLauncher/src-tauri/target/
DesktopLauncher/src-tauri/nsis-hooks.generated.nsh
DesktopLauncher/src-tauri/launcher.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
srv*.log

# Docker
docker-compose.override.yml
**/volumes/
**/pg_data/
**/storage_data/
**/chat_imgs/

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Turbo / Build cache
.turbo/
.vercel/

# TypeScript
*.tsbuildinfo

# Misc
*.pem
*.key
*.crt
*.p12
*.pfx

# Supabase local
supabase/.temp/
supabase/migrations/.backup/

# Backup files
*.bak
*.backup
backups/

# Windows
*.lnk

# v4 monorepo remnants (baseline = gara_reconstruction_v5/)
# Patterns anchored at root (leading /) so they do NOT match same-named dirs inside v5
/apps/
/packages/
/supabase/
/gara_reconstruction/
/screenshots/
/test-video-scenario/
/test-video-scenarios/
/UAT/
/videos/
/exports/
/cookies.txt
/serve.pid
/standalone-build.*
/temp_check.*