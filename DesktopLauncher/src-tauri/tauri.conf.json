{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CencomOS Garage Launcher",
  "version": "0.1.0",
  "identifier": "vn.cencom.garage.launcher",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "CencomOS Garage",
        "decorations": false,
        "devtools": false,
        "fullscreen": true,
        "resizable": false,
        "center": true,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data:; connect-src *; img-src * data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../config.json"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.generated.nsh"
      }
    }
  },
  "plugins": {}
}
