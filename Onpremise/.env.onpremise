# =============================================================================
# .env.onpremise — Template môi trường On-Premise (Intranet) v5 (GĐ9 chuẩn hóa)
# COPY thành .env.onpremise.local, điền secrets — KHÔNG commit file local!
#   cp .env.onpremise .env.onpremise.local
# Sinh key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================
# Stack v5 = PostgreSQL thuần (dịch vụ `db` trong docker-compose.yml) — KHÔNG
# còn Supabase (bỏ bản v4: realtime = Supabase Realtime managed; on-prem v5
# dùng LISTEN/NOTIFY trigger + SSE, xem lib/realtime).

# ===== Database =====
DB_USER=postgres
DB_PASSWORD=THAY-BANG-CHAINHI-64-HEX
DB_NAME=cencom
DB_HOST=db
DB_PORT=5432
# DB_PORT_HOST: cổng HOST khi docker-compose.yml bind — giữ 5432 trên server
# sạch; máy dev khác phải đổi (xem docker-compose.override.yml).
DB_PORT_HOST=5432
DATABASE_URL=postgres://postgres:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ===== Next.js =====
NEXT_PUBLIC_BASE_URL=https://xsc.cencom.lan

# ===== Security (BẮT BUỘC đổi cả hai trước khi mở LAN) =====
SESSION_SECRET=THAY-BANG-64-KY-TU-HEX
SECURE_COOKIE=1
LOGIN_RATE_LIMIT=5

# ===== MCP HTTP (fail-closed: thiếu MCP_PASS/MCP_API_KEY → mcp không mở) =====
# init_db.sh tự tạo/tạo-lại tài khoản app role thấp cho MCP qua create-mcp-user
MCP_USER=mcp-gara
MCP_PASS=THAY-BANG-CHAINAU-NHIEN-32-HEX
MCP_ROLE=giamdoc
MCP_API_KEY=THAY-BANG-64-HEX
MCP_WRITE_TOOLS=

# ===== Other =====
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
LOG_LEVEL=info
FORCE_PW_CHANGE=1
ALLOW_RESET=0
