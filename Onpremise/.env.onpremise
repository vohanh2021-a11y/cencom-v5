# =============================================================================
# .env.onpremise — Environment variables cho triển khai On-Premise (Intranet)
# =============================================================================
# Copy file này thành: .env.onpremise.local
# Sửa giá trị trước khi deploy. Thêm .env.onpremise.local vào .gitignore!
# =============================================================================

# ===== Database (PostgreSQL self-hosted trong Docker) =====
DB_USER=postgres
DB_PASSWORD=cencom_pass_2026
DB_NAME=cencom_os
DB_HOST=supabase-db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ===== Supabase local (Realtime + Storage self-hosted) =====
# Storage API URL (dùng cho Supabase client)
SUPABASE_URL=http://supabase-storage:54325
SUPABASE_ANON_KEY=local-anon-key-2026
SUPABASE_SERVICE_KEY=local-service-role-key-2026
SUPABASE_PORT=54325
# Realtime WebSocket URL (trong Docker network)
SUPABASE_REALTIME_URL=ws://supabase-realtime:54324

# ===== Next.js =====
NEXT_PUBLIC_BASE_URL=https://cencom.lan
NEXT_PUBLIC_SUPABASE_URL=http://supabase-storage:54325
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key-2026

# ===== Security =====
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=thay-bang-64-ky-tu-hex-random-generated-by-node-crypto
# HTTPS → bật Secure cookie
SECURE_COOKIE=1
# Rate limit login
LOGIN_RATE_LIMIT=1

# ===== Seed (chỉ dùng CLI init, KHÔNG dùng production) =====
FORCE_PW_CHANGE=1
ALLOW_RESET=0

# ===== Other =====
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
