# On-Premise deployment â€” files that should NOT be committed
.env.onpremise.local
nginx/certs/server.crt
nginx/certs/server.key
nginx/certs/*.pem
nginx/certs/*.csr
volumes/pg_data/*
volumes/storage_data/*
backups/
*.log

# backup dumps (real data) + cron log — never commit
backup/*.sql.gz
backup/cron.log
