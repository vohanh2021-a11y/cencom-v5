{
  "name": "cencomos-gara",
  "version": "5.2.0",
  "private": true,
  "description": "CencomOS Gara v5 — Desktop/Cloud garage management system. Baseline: gara_reconstruction_v5/.",
  "type": "module",
  "scripts": {
    "dev": "cd gara_reconstruction_v5 && npm run dev",
    "build": "cd gara_reconstruction_v5 && npm run build",
    "start": "cd gara_reconstruction_v5 && npm run start",
    "typecheck": "cd gara_reconstruction_v5 && npm run tsc",
    "lint": "cd gara_reconstruction_v5 && npm run lint",
    "seed": "cd gara_reconstruction_v5 && npm run seed",
    "migrate": "cd gara_reconstruction_v5 && npm run migrate",
    "test": "cd gara_reconstruction_v5 && npm run test",
    "test:conformance": "cd gara_reconstruction_v5 && npm run test:conformance",
    "test:load": "node scripts/load-runner.mjs",
    "smoke": "cd gara_reconstruction_v5 && npm run smoke",
    "e2e": "cd gara_reconstruction_v5 && npm run e2e",
    "mcp": "cd gara_reconstruction_v5 && npm run mcp",
    "cleanup": "cd gara_reconstruction_v5 && npm run cleanup",
    "backup": "bash Onpremise/scripts/backup.sh",
    "restore": "bash Onpremise/scripts/restore.sh",
    "cron:daily": "npm run cleanup && npm run backup",
    "cron:install": "bash scripts/setup_cron.sh",
    "health": "bash scripts/health_check.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "playwright": "^1.62.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
